# VHS Recording Script for Kobayashi Maru Demo
# Run: vhs assets/demo.tape -> produces assets/demo.gif

Output assets/demo.gif

Set Shell "zsh"
Set FontSize 14
Set Width 1200
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"

Type "pi --model auto/planner-worker"
Enter
Sleep 2s

Type "Refactor the authentication middleware to support JWT refresh tokens and add tests"
Enter
Sleep 4s

Type "/reducer status"
Enter
Sleep 2s

Type "/switch grok"
Enter
Sleep 2s

Type "exit"
Enter
Sleep 1s

Type "kobayashi stats"
Enter
Sleep 5s
