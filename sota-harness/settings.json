{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "packages": [
    "git:github.com/NVlabs/SoL-Pi",
    "npm:pi-bedrock-mantle",
    "npm:pi-usage-dashboard",
    "npm:pi-stats-dashboard"
  ],
  "defaultProvider": "bedrock-mantle",
  "defaultModel": "openai.gpt-5.6-luna",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "+codemode"
  ],
  "enabledModels": [
    "amazon-bedrock/us.anthropic.claude-sonnet-5-5:high",
    "amazon-bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0:high",
    "bedrock-mantle/openai.gpt-5.6-luna",
    "ollama/ornith-1.5:ctx:max"
  ],
  "cacheWarming": "streaming",
  "showCacheMissNotices": true,
  "quietStartup": "header",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "codemode.mode": "on",
  "codemode.inlineBudget": 2500,
  "markdown.mermaid": "streaming",
  "fullscreenCopyOnSelect": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 6144,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  }
}
