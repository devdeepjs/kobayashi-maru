{
  "name": "kobayashi-maru",
  "version": "1.0.0",
  "description": "Kobayashi Maru (小林丸): Zero-waste autonomous engineering runtime for Pi & open models. Dynamic BM25 Skill-RAG, NVIDIA SoL-Pi compaction, dual virtual model routing, and AST-grep codebase topology mapping.",
  "type": "module",
  "bin": {
    "kobayashi": "./dist/bin/kobayashi.js"
  },
  "scripts": {
    "start": "tsx bin/kobayashi.ts start",
    "apply": "tsx bin/kobayashi.ts apply",
    "doctor": "tsx bin/kobayashi.ts doctor",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "kobayashi-maru",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai-agents",
    "autonomous-agent",
    "token-efficiency",
    "skill-rag",
    "sol-pi",
    "deepseek",
    "ast-grep",
    "prompt-caching",
    "ollama",
    "bedrock",
    "claude",
    "skills"
  ],
  "author": "dd",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/credential-providers": "^3.1160.0",
    "@inquirer/prompts": "^8.7.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^8.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
